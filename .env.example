# Copy to .env locally; DO NOT put real secrets in this file.
APP_ENV=development
APP_NAME=Dove Racing Clocking System
DATABASE_URL=postgresql+psycopg://dove_user:CHANGE_ME@localhost:5432/dove_racing
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
RFID_MODE=simulator
QR_CLOCKING_ENABLED=true
DEFAULT_MIN_SPEED_MPM=500
DEFAULT_GUEST_RANKING_MODE=separate
